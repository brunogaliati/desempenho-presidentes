{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desempenho-do-governo-www",
  "main": "redirect-www.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  // As rotas por protocolo têm precedência sobre a rota www genérica do site.
  "routes": [
    { "pattern": "https://www.desempenhodogoverno.com.br/*", "zone_name": "desempenhodogoverno.com.br" },
    { "pattern": "http://www.desempenhodogoverno.com.br/*", "zone_name": "desempenhodogoverno.com.br" }
  ]
}
