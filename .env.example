# Connection string do Neon (Dashboard → Connect → Pooled connection).
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require

# Segredo compartilhado com o GitHub Actions do backend, que chama
# POST /api/revalidate depois de atualizar os dados.
REVALIDATE_TOKEN=

# SEO: domínio canônico sem caminho. Previews da Vercel e desenvolvimento
# recebem noindex automaticamente. Em outras homologações, use false.
SITE_URL=https://desempenhodogoverno.com.br
SEO_INDEXING=true
# Tokens públicos de verificação, quando as propriedades forem cadastradas.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Opcional: registra Core Web Vitals nos logs do servidor, sem cookies.
# Ativar no ambiente de produção e refazer o build.
NEXT_PUBLIC_WEB_VITALS=false
